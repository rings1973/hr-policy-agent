# Copy to .env and fill in keys. Never commit .env.
APP_NAME=hr-policy-agent
APP_ENV=development

# LLM providers, tried in order (falls back on 429 / 5xx / timeout)
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Retrieval
EMBEDDING_BACKEND=gemini
INDEX_DIR=app/data/index
VECTOR_TOP_K=4
# Optional: override the per-embedder weak-evidence threshold (gemini 0.60, tfidf 0.10)
MIN_SCORE=

# MCP transport: stdio (subprocess) or http (separate server at MCP_SERVER_URL)
MCP_TRANSPORT=stdio
MCP_SERVER_URL=

# Agent
AGENT_MAX_STEPS=8
SEED=42
MOCK_DATA_DIR=mock_data
# Optional: pin "today" (YYYY-MM-DD) for PTO/remote date rules so eval runs are reproducible
REFERENCE_DATE=
GPT_OSS_REASONING_EFFORT=medium
